# ARGUS local development environment file.
# Copy to .env and fill in real values. .env is gitignored — never commit it.
#
# This file serves two purposes:
#  - ARGUS_* keys are read as typed config (see packages/config/settings.py)
#  - plain keys at the bottom are read as secrets, via SecretsProvider
#    (see packages/config/secrets.py) — never as config fields.

# Environment selector — development | staging | production
ARGUS_ENV=development

# Database connection (Module 03)
ARGUS_DATABASE__HOST=localhost
ARGUS_DATABASE__PORT=
ARGUS_DATABASE__NAME=
ARGUS_DATABASE__USER=

# FMP provider (Module 04)
ARGUS_PROVIDERS__FMP_BASE_URL=https://financialmodelingprep.com/api
ARGUS_PROVIDERS__FMP_REQUEST_TIMEOUT_SECONDS=30

# Execution mode — live | historical_batch
ARGUS_EXECUTION__MODE=live

# Logging
ARGUS_LOGGING__LEVEL=INFO
ARGUS_LOGGING__FORMAT=text

# Secrets resolution (local dev only — DotEnvSecretsProvider reads this same file)
ARGUS_SECRETS__DOTENV_PATH=.env

# --- Secrets (resolved via SecretsProvider, never read as plain config) ---
DATABASE_PASSWORD=
FMP_API_KEY=
